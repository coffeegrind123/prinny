+/** Backoff for joining the session again after the membership manager gave up. */
+const REJOIN_BASE_DELAY_MS = 1_000;
+const REJOIN_MAX_DELAY_MS = 15_000;
+/** How long to keep trying before the membership counts as failed. */
+const REJOIN_TIMEOUT_MS = 5 * 60_000;
+
 export type MembershipState =
   /** Asking the homeserver for a transport, or preparing it. */
   | { kind: "waitingForTransport" }
@@ -112,22 +119,93 @@ export function createLocalMembership$({
   const joined$ = new BehaviorSubject(true);
   const matrixError$ = new BehaviorSubject<MatrixRTCError | null>(null);
 
+  const fail = (e: unknown): void => {
+    if (matrixError$.value === null)
+      matrixError$.next(
+        new MembershipManagerError(
+          e instanceof Error ? e : new Error(String(e)),
+        ),
+      );
+  };
+
+  // The membership manager gives up after about the delayed-leave delay, and
+  // by then the homeserver has removed our membership as well. If the
+  // homeserver was only briefly unavailable (a node drain, say), we are still
+  // in the SFU but invisible to everyone else. So the session is joined again
+  // with backoff, with what the current join used, and the error only counts
+  // once that has failed for REJOIN_TIMEOUT_MS.
+  let rejoinWith: (() => void) | null = null;
+  let rejoinTimer: ReturnType<typeof setTimeout> | undefined;
+  let rejoinAttempts = 0;
+  let rejoinStartedAt: number | undefined;
+  const resetRejoin = (): void => {
+    clearTimeout(rejoinTimer);
+    rejoinTimer = undefined;
+    rejoinAttempts = 0;
+    rejoinStartedAt = undefined;
+  };
+  scope.onEnd(resetRejoin);
+
+  const onMembershipManagerError = (e: unknown): void => {
+    // A homeserver without sticky events cannot be fixed by retrying
+    const unfixable =
+      e instanceof Error &&
+      e.cause instanceof UnsupportedStickyEventsEndpointError;
+    const rejoin = rejoinWith;
+    if (unfixable || rejoin === null) {
+      logger.error("The membership manager stopped", e);
+      fail(e);
+      return;
+    }
+    rejoinStartedAt ??= Date.now();
+    if (Date.now() - rejoinStartedAt > REJOIN_TIMEOUT_MS) {
+      logger.error("Giving up joining the session again", e);
+      fail(e);
+      return;
+    }
+    const delay = Math.min(
+      REJOIN_BASE_DELAY_MS * 2 ** rejoinAttempts++,
+      REJOIN_MAX_DELAY_MS,
+    );
+    logger.warn(
+      `The membership manager stopped, joining again in ${delay}ms (attempt ${rejoinAttempts})`,
+      e,
+    );
+    clearTimeout(rejoinTimer);
+    rejoinTimer = setTimeout(() => {
+      rejoinTimer = undefined;
+      if (rejoinWith !== rejoin) return;
+      try {
+        // Errors again through the event if the homeserver is still down,
+        // which schedules the next attempt
+        rejoin();
+      } catch (error) {
+        onMembershipManagerError(error);
+      }
+    }, delay);
+  };
+
   scope.reconcile(
     scope.behavior(combineLatest([transport$, joined$])),
     async ([prepared, joined]) => {
       if (prepared === null || !joined) return;
-      try {
+      const join = (): void =>
         joinMatrixRTC(
           prepared.transport,
           prepared.canDelegateDelayedLeave
             ? timings.delegatedDelayedLeave
             : timings.delayedLeave,
         );
+      try {
+        join();
+        rejoinWith = join;
       } catch (e) {
         logger.error("Failed to enter the session", e);
         if (matrixError$.value === null) matrixError$.next(toMatrixRTCError(e));
       }
       return Promise.resolve(async (): Promise<void> => {
+        rejoinWith = null;
+        resetRejoin();
         try {
           await matrixRTCSession.leave(1000);
         } catch (e) {
@@ -149,15 +227,16 @@ export function createLocalMembership$({
