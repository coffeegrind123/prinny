+        rejoin();
+        await flushPromises();
+        await flushPromises();
+
+        expect(track(Track.Source.Microphone)!.isUpstreamPaused).toBe(true);
+      });
+
+      it("publishes nothing on the first connect", async () => {
+        want(microphone);
+        rejoin();
+        await flushPromises();
+
+        expect(participant.createTracks).not.toHaveBeenCalled();
+      });
+
+      it("publishes nothing when it had not started before the drop", async () => {
+        want(microphone);
+        await drop();
+        rejoin();
+        await flushPromises();
+
+        expect(participant.createTracks).not.toHaveBeenCalled();
+      });
