+describe("Rejoining after the SFU drops us", () => {
+  const config: SFUConfig = {
+    url: "wss://matrix-rtc.m.localhost/livekit/sfu",
+    jwt: testJWTToken,
+    livekitAlias: "alias",
+    livekitIdentity: "@me:example.org:ABCDEF",
+  };
+
+  /** Counts the token fetches, which a rejoin repeats to recreate the room. */
+  class CountingConnection extends Connection {
+    public readonly fetches = vi.fn<() => Promise<SFUConfig>>();
+    protected override async getSFUConfig(): Promise<SFUConfig> {
+      return this.fetches();
+    }
+  }
+
+  async function startedConnection(
+    fetches: (mock: CountingConnection["fetches"]) => void = (mock): void => {
+      mock.mockResolvedValue(config);
+    },
+  ): Promise<CountingConnection> {
+    setupTest();
+    fakeLivekitRoom.connect.mockImplementation(async (): Promise<void> => {
+      fakeLivekitRoom.state = LivekitConnectionState.Connected;
+      fakeLivekitRoom.emit(
+        RoomEvent.ConnectionStateChanged,
+        fakeLivekitRoom.state,
+      );
+      return Promise.resolve();
+    });
+    const connection = new CountingConnection(connectionOpts(), logger);
+    // The first fetch is the start's own
+    connection.fetches.mockResolvedValueOnce(config);
+    fetches(connection.fetches);
+    await connection.start();
+    expect(fakeLivekitRoom.connect).toHaveBeenCalledTimes(1);
+    return connection;
+  }
+
+  function drop(reason?: DisconnectReason): void {
+    fakeLivekitRoom.state = LivekitConnectionState.Disconnected;
+    fakeLivekitRoom.emit(RoomEvent.Disconnected, reason);
+  }
+
+  it("fetches a fresh token and reconnects", async () => {
+    vi.useFakeTimers();
+    const connection = await startedConnection();
+
+    drop(DisconnectReason.UNKNOWN_REASON);
+    await vi.advanceTimersByTimeAsync(0);
+
+    expect(connection.fetches).toHaveBeenCalledTimes(2);
+    expect(fakeLivekitRoom.connect).toHaveBeenCalledTimes(2);
+    expect(connection.state$.getValue()).toEqual({
+      state: "authenticated",
+      livekitState: LivekitConnectionState.Connected,
+    });
+  });
+
+  it("backs off and retries when the first attempts fail", async () => {
+    vi.useFakeTimers();
+    const connection = await startedConnection((mock) => {
+      mock
+        .mockRejectedValueOnce(new Error("jwt service down"))
+        .mockRejectedValueOnce(new Error("jwt service down"))
+        .mockResolvedValue(config);
+    });
+
+    drop(DisconnectReason.SERVER_SHUTDOWN);
+    await vi.advanceTimersByTimeAsync(0);
+    expect(connection.fetches).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(connection.fetches).toHaveBeenCalledTimes(3);
+    await vi.advanceTimersByTimeAsync(2000);
+    expect(connection.fetches).toHaveBeenCalledTimes(4);
+    expect(fakeLivekitRoom.connect).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not rejoin after a deliberate disconnect", async () => {
+    vi.useFakeTimers();
+    const connection = await startedConnection();
+
+    drop(DisconnectReason.CLIENT_INITIATED);
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(connection.fetches).toHaveBeenCalledTimes(1);
+    expect(fakeLivekitRoom.connect).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not rejoin after the connection was stopped", async () => {
+    vi.useFakeTimers();
+    const connection = await startedConnection();
+    await connection.stop();
+
+    drop(DisconnectReason.UNKNOWN_REASON);
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(connection.fetches).toHaveBeenCalledTimes(1);
+    expect(connection.state$.getValue()).toEqual({ state: "stopped" });
+  });
+
+  it("gives up with an error after the retry limit", async () => {
+    vi.useFakeTimers();
+    const connection = await startedConnection((mock) => {
+      mock.mockRejectedValue(new Error("gone"));
+    });
+
+    drop(DisconnectReason.UNKNOWN_REASON);
+    await vi.advanceTimersByTimeAsync(120_000);
+
+    // The start's fetch, then seven attempts
+    expect(connection.fetches).toHaveBeenCalledTimes(8);
+    const state = connection.state$.getValue();
+    expect(state.state).toBe("error");
+    if (state.state === "error")
+      expect(state.error).toBeInstanceOf(FailToStartLivekitConnection);
+    expect(fakeLivekitRoom.connect).toHaveBeenCalledTimes(1);
+  });
+});
