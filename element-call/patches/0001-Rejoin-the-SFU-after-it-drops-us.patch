+    describe("after the connection rejoins the room", () => {
+      /** What LiveKit does when it gives up on a session: drop every local track. */
+      async function drop(): Promise<void> {
+        for (const { track } of [...participant.trackPublications.values()])
+          if (track) await participant.unpublishTrack(track, true);
+        (room as unknown as EventEmitter).emit(RoomEvent.Disconnected);
+      }
+
+      function rejoin(): void {
+        (room as unknown as EventEmitter).emit(RoomEvent.Connected);
+      }
+
+      it("publishes the wanted tracks again, live once publishing", async () => {
+        want(microphone, camera);
+        publisher.start();
+        await publisher.startPublishing();
+        await flushPromises();
+
+        await drop();
+        expect(participant.trackPublications.size).toBe(0);
+        rejoin();
+        await flushPromises();
+        await flushPromises();
+
+        expect(track(Track.Source.Microphone)).toBeDefined();
+        expect(track(Track.Source.Camera)).toBeDefined();
+        expect(track(Track.Source.Microphone)!.isUpstreamPaused).toBe(false);
+      });
+
+      it("leaves out what the host muted before the drop", async () => {
+        want(microphone, camera);
+        publisher.start();
+        await flushPromises();
+        desired.get("camera")!.enabled = false;
+
+        await drop();
+        rejoin();
+        await flushPromises();
+        await flushPromises();
+
+        expect(track(Track.Source.Microphone)).toBeDefined();
+        expect(track(Track.Source.Camera)).toBeUndefined();
