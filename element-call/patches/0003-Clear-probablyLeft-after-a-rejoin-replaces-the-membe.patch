From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: blong <belohnung@protonmail.com>
Date: Fri, 30 Oct 2026 01:38:26 +0100
Subject: [PATCH 3/5] Clear probablyLeft after a rejoin replaces the membership
 manager

The rejoin creates a fresh MembershipManager that starts with probablyLeft=false
and only emits ProbablyLeft on a change, so HomeserverConnected kept the stale
true and the call showed 'Reconnecting...' forever while media worked. Re-read
the flag on membership status changes too.

Ported to v0.24.0 from largelanguagemeowing/cinny d744488d; applied
unchanged.
---
 sdk/src/matrixrtc/HomeserverConnected.test.ts | 15 +++++++++++++++
 sdk/src/matrixrtc/HomeserverConnected.ts      | 12 +++++++++---
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/sdk/src/matrixrtc/HomeserverConnected.test.ts b/sdk/src/matrixrtc/HomeserverConnected.test.ts
index c58b8e6d..3914bb0e 100644
--- a/sdk/src/matrixrtc/HomeserverConnected.test.ts
+++ b/sdk/src/matrixrtc/HomeserverConnected.test.ts
@@ -175,6 +175,21 @@ describe("createHomeserverConnected$", () => {
     expect(hsConnected.disconnectReason$.value).toEqual(null);
   });
 
+  it("recovers when a rejoin replaces the manager and probablyLeft clears without a ProbablyLeft event", () => {
+    const hsConnected = createHomeserverConnected$(scope, client, session, 0);
+    client.setSyncState(SyncState.Syncing);
+    session.setMembershipStatus(Status.Connected);
+    session.setProbablyLeft(true);
+    expect(hsConnected.combined$.value).toEqual([false, "probablyLeft"]);
+
+    // A fresh MembershipManager starts with probablyLeft=false and only emits
+    // ProbablyLeft on a change, so all we get is the status moving on.
+    session.probablyLeft = false;
+    session.setMembershipStatus(Status.Connecting);
+    session.setMembershipStatus(Status.Connected);
+    expect(hsConnected.combined$.value).toEqual([true, null]);
+  });
+
   it("composite sequence reflects each individual failure reason", () => {
     const hsConnected = createHomeserverConnected$(scope, client, session, 0);
 
diff --git a/sdk/src/matrixrtc/HomeserverConnected.ts b/sdk/src/matrixrtc/HomeserverConnected.ts
index a1edaf6e..1a51d43c 100644
--- a/sdk/src/matrixrtc/HomeserverConnected.ts
+++ b/sdk/src/matrixrtc/HomeserverConnected.ts
@@ -23,6 +23,7 @@ import {
   of,
   delay,
   combineLatest,
+  merge,
 } from "rxjs";
 import { logger as rootLogger } from "matrix-js-sdk/lib/logger";
 
@@ -105,9 +106,14 @@ export function createHomeserverConnected$(
   //
   // If that is not the case we certainly still have a valid membership on the matrix network
   // independet if the sync currently works.
-  const certainlyConnected$ = fromEvent(
-    matrixRTCSession,
-    MembershipManagerEvent.ProbablyLeft,
+  //
+  // A rejoin after the membership manager gave up creates a fresh manager that
+  // starts with probablyLeft=false, so it never emits ProbablyLeft(false) to
+  // clear the old flag. Re-read it on status changes too, or we would stay
+  // "probablyLeft" (and show the reconnecting toast) forever.
+  const certainlyConnected$ = merge(
+    fromEvent(matrixRTCSession, MembershipManagerEvent.ProbablyLeft),
+    fromEvent(matrixRTCSession, MembershipManagerEvent.StatusChanged),
   ).pipe(
     startWith(null),
     map(() => matrixRTCSession.probablyLeft !== true),
