diff --git a/src/UrlParams.ts b/src/UrlParams.ts
index 805cab71..1205113e 100644
--- a/src/UrlParams.ts
+++ b/src/UrlParams.ts
@@ -251,6 +251,14 @@ export interface UrlConfiguration {
   noiseSuppression?: boolean;
 
   callIntent?: RTCCallIntent;
+
+  /**
+   * Replacement URLs for the sounds Element Call plays itself, keyed by sound name
+   * (ringtone, ringtoneIntro, join, left, decline, timeout, raiseHand,
+   * screenshareStarted). The embedding client passes them as JSON so it can theme
+   * call sounds. Names not listed keep the default.
+   */
+  soundOverrides?: Record<string, string>;
 }
 
 // If you need to add a new flag to this interface, prefer a name that describes
@@ -314,6 +322,22 @@ class ParamParser {
   }
 }
 
+function parseSoundOverrides(raw: string | null): Record<string, string> {
+  if (raw === null) return {};
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (typeof parsed !== "object" || parsed === null) return {};
+    return Object.fromEntries(
+      Object.entries(parsed).filter(
+        (entry): entry is [string, string] => typeof entry[1] === "string",
+      ),
+    );
+  } catch {
+    logger.warn("Ignoring malformed soundOverrides url param");
+    return {};
+  }
+}
+
 let urlParamCache: {
   search?: string;
   hash?: string;
@@ -498,6 +522,7 @@ export const computeUrlParams = (search = "", hash = ""): UrlParams => {
     autoLeaveWhenOthersLeft: parser.getFlag("autoLeave"),
     noiseSuppression: parser.getFlagParam("noiseSuppression", true),
     echoCancellation: parser.getFlagParam("echoCancellation", true),
+    soundOverrides: parseSoundOverrides(parser.getParam("soundOverrides")),
   };
 
   // Log the final configuration for debugging purposes.
